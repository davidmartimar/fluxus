# Copy to .env and adjust. Real environment variables override these values.

# --- STT ---
FLUXUS_STT_ENGINE=local          # local | api
# Model: tiny | base | small | medium | large-v3 | large-v3-turbo
# Leave commented to pick by device: large-v3-turbo on CUDA (~1.6 GB download), small on CPU.
# FLUXUS_WHISPER_MODEL=small
FLUXUS_WHISPER_DEVICE=auto       # auto | cuda | cpu
FLUXUS_LANGUAGE=es               # es | en | auto

# Words Whisper should favour (names, jargon), comma-separated.
# FLUXUS_HOTWORDS=FLUXUS, Kubernetes, Marcasombra
# Style sample Whisper imitates (punctuation, accents). Commented = built-in sample
# for the language; set it empty (FLUXUS_INITIAL_PROMPT=) to disable.
# FLUXUS_INITIAL_PROMPT=Hola, ¿qué tal? Te escribo para confirmar la reunión del martes.

# Silence filter: lower threshold keeps softer speech; padding avoids clipping words.
# FLUXUS_VAD_THRESHOLD=0.35
# FLUXUS_VAD_SPEECH_PAD_MS=600

# --- LLM (optional) ---
FLUXUS_LLM_ENABLED=false
FLUXUS_LLM_MODEL=gpt-4o-mini

# Required for the api STT engine or LLM refinement. Never commit your real key.
OPENAI_API_KEY=

# --- UI ---
FLUXUS_HOTKEY=ctrl+shift+space
# Paste the transcript into the window you were in (it is always copied too).
FLUXUS_AUTO_PASTE=true
